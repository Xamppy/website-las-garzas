---
import Base from "../layouts/Base.astro";
import Slat from "../components/Slat.astro";

/* Los cinco distintivos de la columna izquierda */
const distintivos = [
  { icon: "logistica", label: "Transporte\nMinero" },
  { icon: "servicios", label: "Áridos" },
  { icon: "rental-mining", label: "Rental\nMining" },
  { icon: "maquinaria", label: "Maquinaria" },
  { icon: "sostenible", label: "Compromiso\nSostenible" },
];

/* Franjas con el orden y filo según el diseño: verde · blanco · rojo */
const areas = [
  {
    title: "Rental Mining",
    image: "rental-mining",
    icon: "rental-mining",
    edge: "green" as const,
    description: "Arriendo de maquinaria y equipos con respaldo y mantención.",
  },
  {
    title: "Logística",
    image: "logistica",
    icon: "logistica",
    edge: "white" as const,
    description: "Transporte de carga para faenas mineras e industriales.",
  },
  {
    title: "Servicios",
    image: "servicios",
    icon: "servicios",
    edge: "red" as const,
    description: "Movimiento de tierra, áridos y apoyo a la operación en faena.",
  },
];

/* Distintivos del footer inferior */
const footerFeatures = [
  {
    icon: "areas-negocio",
    line1: "Nuevas áreas",
    line2: "de negocio",
  },
  {
    icon: "conectividad",
    line1: "Mayor",
    line2: "conectividad",
  },
  {
    icon: "seguridad",
    line1: "Información",
    line2: "más accesible",
  },
  {
    icon: "entorno",
    line1: "El mismo compromiso",
    line2: "con la seguridad y el entorno",
  },
];
---

<Base>
  <div class="stage">
    <main class="board">
      <!-- ---------- Navbar blanco superior con distinción ---------- -->
      <header class="navbar">
        <div class="navbar__brand">
          <img class="navbar__mark" src="/img/glg-logo.svg" width="68" height="68" alt="" aria-hidden="true" />
          <p class="navbar__name">Grupo Empresas<br /><strong>Las Garzas</strong></p>
          <span class="navbar__sep" aria-hidden="true"></span>
          <p class="navbar__years">Más de <strong>32 años</strong><br />de experiencia</p>
        </div>
      </header>

      <!-- ---------- Hero principal: video y portal empresarial ---------- -->
      <section class="board__hero">
        <!-- Fondo de video a lo ancho -->
        <div class="board__media" aria-hidden="true">
          <video
            class="board__video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/img/video-poster.webp"
          >
            <source src="/video/GLG_web_Video.mp4" type="video/mp4" />
          </video>
          <!-- Difuminado del video hacia el blanco del contenido -->
          <div class="board__fade"></div>
        </div>

        <!-- Columna de contenido: en móvil aparece de inmediato tras el navbar -->
        <div class="board__content">
          <div class="copy">
            <p class="copy__eyebrow">Portal empresarial</p>
            <h1 class="copy__title">En renovación</h1>
            <p class="copy__tagline">Más soluciones para un mejor mañana</p>

            <div class="tricolor" aria-hidden="true"><span></span><span></span><span></span></div>

            <p class="copy__lead">
              Estamos actualizando nuestro portal para brindarte una mejor
              experiencia, con más información, nuevas áreas y un acceso más
              directo a nuestros servicios.
            </p>

            <ul class="marks">
              {
                distintivos.map((d) => (
                  <li class="marks__item">
                    <img src={`/icons/${d.icon}.svg`} width="64" height="64" alt="" aria-hidden="true" />
                    <span>{d.label}</span>
                  </li>
                ))
              }
            </ul>

            <p class="badge"><span class="badge__dot" aria-hidden="true"></span>Próximamente</p>
            <p class="motto">Un mismo grupo, más oportunidades.</p>
          </div>
        </div>
      </section>

      <!-- ---------- Franjas diagonales (en móvil aparecen después del contenido) ---------- -->
      <div class="board__slats">
        {areas.map((a) => <Slat {...a} eager />)}
      </div>

      <!-- ---------- Footer negro inferior amplio y visible ---------- -->
      <footer class="footer">
        <div class="footer__features">
          {
            footerFeatures.map((f) => (
              <div class="footer__feature">
                <img class="footer__icon" src={`/icons/${f.icon}.svg`} width="44" height="44" alt="" aria-hidden="true" />
                <span class="footer__text">
                  {f.line1}
                  <br />
                  {f.line2}
                </span>
              </div>
            ))
          }
        </div>

        <div class="footer__brand">
          <p class="footer__brand-title">Grupo Empresas Las Garzas</p>
          <p class="footer__brand-sub">Construyendo con experiencia</p>
          <div class="footer__tricolor tricolor" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </div>
      </footer>
    </main>
  </div>
</Base>

<style>
  :root {
    --nav-h: clamp(76px, 9vh, 92px);
    --footer-h: clamp(86px, 11vh, 108px);
  }

  /* ===================== Escenario y tablero ===================== */
  .stage {
    height: 100svh;
    min-height: 100svh;
    width: 100vw;
    background: #000;
    display: flex;
    overflow: hidden;
    position: relative;
  }

  .board {
    position: relative;
    flex: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #fff;
    isolation: isolate;
  }

  /* ===================== Navbar blanco superior ===================== */
  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-h);
    z-index: 20;
    display: flex;
    align-items: center;
    padding-inline: clamp(1.4rem, 3.2vw, 3.4rem);
    background: linear-gradient(
      to right,
      #ffffff 0%,
      #ffffff 48%,
      rgba(255, 255, 255, 0.94) 58%,
      rgba(255, 255, 255, 0) 75%
    );
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    pointer-events: none;
  }

  .navbar__brand {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 1.4vw, 1.2rem);
    pointer-events: auto;
  }

  .navbar__mark {
    width: clamp(50px, 4.6vw, 72px);
    height: auto;
  }

  .navbar__name {
    font-size: clamp(0.9rem, 0.65rem + 0.85vw, 1.4rem);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--glg-ink);
    font-weight: 500;
  }
  .navbar__name strong {
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .navbar__sep {
    width: 1px;
    align-self: stretch;
    min-height: 2.2em;
    background: rgba(14, 15, 17, 0.22);
  }

  .navbar__years {
    font-size: clamp(0.68rem, 0.56rem + 0.35vw, 0.92rem);
    line-height: 1.25;
    color: rgba(14, 15, 17, 0.68);
  }
  .navbar__years strong {
    color: var(--glg-ink);
    font-weight: 700;
  }

  /* ===================== Hero (en escritorio abarca toda la pantalla) ===================== */
  .board__hero {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* ===================== Video y difuminado ===================== */
  .board__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .board__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Difuminado suave: blanco detrás del texto, transparente en el centro
     para que el video de la carretera y máquinas sea plenamente visible */
  .board__fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      #ffffff 0%,
      #ffffff 18%,
      rgba(255, 255, 255, 0.9) 26%,
      rgba(255, 255, 255, 0.45) 36%,
      rgba(255, 255, 255, 0) 46%
    );
  }

  /* ===================== Columna de contenido ===================== */
  .board__content {
    position: absolute;
    top: var(--nav-h);
    bottom: var(--footer-h);
    left: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: clamp(1.4rem, 3vw, 3.2rem);
    width: min(45%, 620px);
    pointer-events: none;
  }

  .board__content :where(a, button) {
    pointer-events: auto;
  }

  /* ===================== Franjas diagonales ===================== */
  .board__slats {
    position: absolute;
    top: var(--nav-h);
    bottom: var(--footer-h);
    right: 0;
    z-index: 2;
    display: flex;
    width: 50%;
    --slant: -11deg;
    --slat-overlap: 0px;
    --edge-w: 5px;
    margin-right: 0;
  }

  .board__slats :global(.slat) {
    flex: 1 1 0;
  }

  /* ===================== Bloque de texto ===================== */
  .copy {
    display: grid;
    gap: clamp(0.3rem, 0.8vh, 0.7rem);
    justify-items: start;
    max-width: min(38rem, 100%);
  }

  .copy__eyebrow {
    font-size: clamp(0.88rem, 0.68rem + 0.65vw, 1.4rem);
    color: rgba(14, 15, 17, 0.78);
    font-weight: 400;
  }

  .copy__title {
    font-size: clamp(1.75rem, 0.72rem + 3.1vw, 3.6rem);
    line-height: 1;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--glg-ink);
    text-wrap: balance;
  }

  .copy__tagline {
    font-size: clamp(0.88rem, 0.66rem + 0.7vw, 1.45rem);
    color: rgba(14, 15, 17, 0.82);
    font-weight: 400;
  }

  .tricolor {
    width: clamp(140px, 16vw, 270px);
    height: clamp(7px, 0.8vw, 13px);
    border-radius: 2px;
    margin-block: clamp(0.1rem, 0.35vh, 0.35rem);
  }

  .copy__lead {
    font-size: clamp(0.74rem, 0.58rem + 0.42vw, 0.98rem);
    line-height: 1.45;
    color: rgba(14, 15, 17, 0.78);
    max-width: min(28rem, 100%);
  }

  /* ===================== Fila de distintivos ===================== */
  .marks {
    display: flex;
    flex-wrap: nowrap;
    align-items: start;
    gap: clamp(0.35rem, 1vw, 1.1rem);
    margin: clamp(0.15rem, 0.7vh, 0.5rem) 0 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }

  .marks__item {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    flex: 1 1 0;
    min-width: 0;
    max-width: 88px;
    text-align: center;
    font-size: clamp(0.42rem, 0.35rem + 0.22vw, 0.62rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--glg-ink);
    white-space: pre-line;
  }

  .marks__item img {
    width: clamp(34px, 3.6vw, 58px);
    height: auto;
  }

  /* ===================== Botón y cierre ===================== */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: clamp(0.2rem, 0.7vh, 0.55rem);
    padding: clamp(0.55rem, 0.9vh, 0.8rem) clamp(1.4rem, 2.2vw, 2.2rem);
    border-radius: 999px;
    background: var(--glg-green);
    color: #fff;
    font-size: clamp(0.85rem, 0.66rem + 0.5vw, 1.25rem);
    font-weight: 500;
    box-shadow: 0 6px 20px rgba(45, 138, 72, 0.32);
  }

  .badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    animation: pulse 2.4s var(--ease) infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.4; transform: scale(0.8); }
  }

  .motto {
    font-style: italic;
    font-weight: 600;
    font-size: clamp(0.78rem, 0.64rem + 0.4vw, 1.05rem);
    color: var(--glg-ink);
    text-shadow: 0 1px 3px rgba(255, 255, 255, 0.9), 0 0 10px #ffffff;
  }

  /* ===================== Footer negro inferior ===================== */
  .footer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--footer-h);
    z-index: 20;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: clamp(1.4rem, 3.2vw, 3.4rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer__features {
    display: flex;
    align-items: center;
    gap: clamp(1.4rem, 2.6vw, 3.5rem);
  }

  .footer__feature {
    display: flex;
    align-items: center;
    gap: clamp(0.55rem, 0.8vw, 0.9rem);
    color: #ffffff;
  }

  .footer__icon {
    width: clamp(34px, 2.8vw, 46px);
    height: auto;
    color: #ffffff;
    flex-shrink: 0;
  }

  .footer__text {
    font-size: clamp(0.58rem, 0.48rem + 0.22vw, 0.74rem);
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1.25;
    letter-spacing: 0.025em;
    color: #ffffff;
    white-space: pre-line;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    flex-shrink: 0;
  }

  .footer__brand-title {
    font-size: clamp(0.78rem, 0.65rem + 0.35vw, 1.05rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #ffffff;
  }

  .footer__brand-sub {
    font-size: clamp(0.64rem, 0.54rem + 0.24vw, 0.85rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 2px;
  }

  .footer__tricolor {
    width: clamp(150px, 15vw, 240px);
    height: 5px;
    margin-top: 5px;
    border-radius: 2px;
  }

  /* ===================== Pantallas medianas ===================== */
  @media (max-width: 1100px) {
    .board__slats { width: 46%; }
    .board__content { width: min(55%, 580px); }
    .footer__features { gap: 1.2rem; }
  }

  /* ===================== Móvil: se apila con scroll ordenado ===================== */
  @media (max-width: 860px) {
    .stage {
      height: auto;
      min-height: 100svh;
      overflow: visible;
    }

    .board {
      display: flex;
      flex-direction: column;
      height: auto;
      min-height: 100svh;
      position: relative;
    }

    .navbar {
      position: relative;
      height: auto;
      padding: 1.2rem 1.4rem;
      background: #ffffff;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      z-index: 10;
    }

    /* En móvil el hero contiene el video y el contenido con altura adaptada */
    .board__hero {
      position: relative;
      inset: auto;
      width: 100%;
      min-height: auto;
      z-index: 1;
      overflow: hidden;
    }

    .board__media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .board__video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
    }

    .board__fade {
      background: linear-gradient(
        to bottom,
        #ffffff 0%,
        rgba(255, 255, 255, 0.96) 25%,
        rgba(255, 255, 255, 0.9) 50%,
        rgba(255, 255, 255, 0.52) 75%,
        rgba(255, 255, 255, 0.22) 88%,
        rgba(255, 255, 255, 0.75) 100%
      );
    }

    .board__content {
      position: relative;
      top: auto;
      bottom: auto;
      left: auto;
      width: 100%;
      padding: 2rem 1.4rem 2.8rem;
      pointer-events: auto;
      z-index: 2;
    }

    /* Las franjas van después del hero (después del texto) */
    .board__slats {
      position: relative;
      top: auto;
      bottom: auto;
      right: auto;
      width: 100%;
      height: auto;
      --slant: 0deg;
      --edge-w: 0px;
      margin-right: 0;
      flex-direction: column;
      border-top: 4px solid var(--glg-green);
      z-index: 3;
    }

    .board__slats :global(.slat) {
      flex: 0 0 auto;
      height: clamp(230px, 42vw, 320px);
      border-left: 0;
      border-bottom: 4px solid var(--edge-color);
    }

    .board__slats :global(.slat__inner) {
      width: 100%;
      left: 0;
    }

    .footer {
      position: relative;
      bottom: auto;
      left: auto;
      right: auto;
      height: auto;
      padding: 2rem 1.4rem;
      flex-direction: column;
      gap: 1.8rem;
      align-items: flex-start;
      z-index: 4;
    }

    .footer__features {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.2rem;
    }

    .footer__brand {
      align-items: flex-start;
      text-align: left;
    }

    .copy { max-width: 100%; }
    .marks { gap: clamp(0.5rem, 2.5vw, 1rem); }
    .motto {
      font-weight: 750;
      font-size: 0.95rem;
      color: #0e0f11;
      text-shadow: 0 1px 3px #ffffff, 0 0 10px #ffffff, 0 0 18px rgba(255, 255, 255, 0.95);
      letter-spacing: 0.01em;
      margin-top: 0.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .board__video { display: none; }
    .board__media {
      background-image: url("/img/video-poster.webp");
      background-size: cover;
      background-position: center;
    }
    .badge__dot { animation: none; }
  }
</style>

<script>
  const v = document.querySelector<HTMLVideoElement>(".board__video");
  if (v) {
    const play = () => v.play().catch(() => {});
    v.addEventListener("ended", () => { v.currentTime = 0; play(); });
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden && v.paused) play();
    });
    play();
    window.addEventListener("touchstart", () => { if (v.paused) play(); }, { once: true });
  }
</script>
