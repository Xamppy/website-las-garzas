---
interface Props {
  title: string;
  /** slug de /img/<slug>-slat.webp */
  image: string;
  /** slug de /icons/<slug>.svg */
  icon: string;
  description: string;
  /** Color del filo diagonal: verde, blanco o rojo (barra de marca) */
  edge: "green" | "white" | "red";
  /** Carga ansiosa: las franjas visibles de entrada no deben ir en lazy */
  eager?: boolean;
}

const { title, image, icon, description, edge, eager = false } = Astro.props;
---

<article class={`slat slat--${edge}`} tabindex="0">
  <!-- Capa de imagen contra-inclinada para encuadre recto -->
  <div class="slat__inner">
    <img
      class="slat__img"
      src={`/img/${image}-slat.webp`}
      srcset={`/img/${image}-slat-sm.webp 380w, /img/${image}-slat.webp 760w`}
      sizes="(max-width: 900px) 100vw, 24vw"
      width="760"
      height="1520"
      alt={title}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
    <div class="slat__tint"></div>
  </div>

  <!-- Rótulo en reposo: arriba, centrado en la zona visible -->
  <h3 class="slat__label">{title}</h3>

  <!-- Título en hover: orientado a lo largo de la diagonal, fuente destacada y sin cortes -->
  <div class="slat__hover-title" aria-hidden="true">
    <span>{title}</span>
  </div>

  <!-- Panel inferior al hacer hover: ícono y descripción centrados -->
  <div class="slat__panel">
    <div class="slat__panel-inner">
      <div class="slat__icon-wrap">
        <img class="slat__icon" src={`/icons/${icon}.svg`} width="54" height="54" alt="" aria-hidden="true" />
      </div>
      <p class="slat__desc">{description}</p>
    </div>
  </div>
</article>

<style>
  .slat {
    position: relative;
    height: 100%;
    overflow: hidden;
    cursor: pointer;
    transform: skewX(var(--slant));
    margin-inline: calc(var(--slat-overlap, 0px) * -1);
    border-left: var(--edge-w, 5px) solid var(--edge-color);
    transition: flex-grow 520ms var(--ease);
    isolation: isolate;
  }

  .slat--green { --edge-color: var(--glg-green); }
  .slat--white { --edge-color: #ffffff; }
  .slat--red   { --edge-color: var(--glg-red); }

  .slat__inner {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -30%;
    width: 160%;
    transform: skewX(calc(var(--slant) * -1));
    z-index: 1;
  }

  .slat__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    transition: transform 620ms var(--ease), filter 620ms var(--ease);
  }

  .slat__tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 9, 10, 0.65) 0%,
      rgba(8, 9, 10, 0.08) 40%,
      rgba(8, 9, 10, 0.22) 100%
    );
    transition: opacity 480ms var(--ease);
  }

  /* Rótulo en reposo: centrado arriba */
  .slat__label {
    position: absolute;
    top: 14%;
    left: 50%;
    translate: -50% 0;
    transform: skewX(calc(var(--slant) * -1));
    z-index: 3;
    margin: 0;
    width: max-content;
    max-width: 90%;
    text-align: center;
    font-size: clamp(0.72rem, 0.58rem + 0.32vw, 0.95rem);
    font-weight: 750;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.95), 0 0 24px rgba(0, 0, 0, 0.7);
    transition: opacity 250ms var(--ease), transform 250ms var(--ease), visibility 250ms;
    pointer-events: none;
    white-space: nowrap;
  }

  /* Ajuste de posición del label para que no se corte en los extremos */
  :global(.slat:last-child) .slat__label {
    left: 42%;
  }

  :global(.slat:first-child) .slat__label {
    left: 54%;
  }

  /* Título en hover: fuente amplia, posicionado con margen inferior para despejar la parte superior */
  .slat__hover-title {
    position: absolute;
    left: clamp(38px, 3.4vw, 64px);
    top: 64%;
    transform-origin: 0 0;
    transform: rotate(-90deg) translateY(-8px);
    z-index: 5;
    pointer-events: none;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 350ms var(--ease), transform 350ms var(--ease);
  }

  .slat__hover-title span {
    display: inline-block;
    font-size: clamp(1.35rem, 0.95rem + 1.25vw, 2.35rem);
    font-weight: 800;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.95), 0 0 28px rgba(0, 0, 0, 0.85);
  }

  /* Panel inferior: ícono y descripción centrados */
  .slat__panel {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 4;
    padding: clamp(1.2rem, 3.2vh, 2.2rem) clamp(0.7rem, 1.6vw, 1.4rem) clamp(1rem, 2.4vh, 1.6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    background: linear-gradient(
      to top,
      rgba(4, 5, 7, 0.92) 0%,
      rgba(4, 5, 7, 0.6) 55%,
      rgba(4, 5, 7, 0) 100%
    );
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 400ms var(--ease), transform 400ms var(--ease);
    pointer-events: none;
  }

  .slat__panel-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.55rem;
    width: 100%;
    transform: skewX(calc(var(--slant) * -1));
  }

  .slat__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .slat__icon {
    width: clamp(38px, 3vw, 52px);
    height: auto;
    filter: drop-shadow(0 3px 10px rgba(0, 0, 0, 0.6));
  }

  .slat__desc {
    margin: 0;
    font-size: clamp(0.7rem, 0.62rem + 0.22vw, 0.86rem);
    line-height: 1.38;
    color: rgba(255, 255, 255, 0.92);
    max-width: 24ch;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.85);
  }

  /* ---------------- Adaptabilidad para escala de 125% y pantallas compactas ---------------- */
  @media (max-height: 860px) {
    .slat__hover-title {
      top: 65%;
      left: clamp(34px, 3vw, 52px);
    }
    .slat__hover-title span {
      font-size: clamp(1.2rem, 3.8vh, 1.95rem);
    }
  }

  @media (max-height: 720px) {
    .slat__hover-title {
      top: 66%;
      left: clamp(28px, 2.6vw, 42px);
    }
    .slat__hover-title span {
      font-size: clamp(1.1rem, 3.6vh, 1.65rem);
    }
    .slat__panel {
      padding-bottom: 0.8rem;
    }
  }

  /* ---------------- Interacción Hover y Teclado ---------------- */
  @media (hover: hover) {
    .slat:hover,
    .slat:focus-visible {
      flex-grow: 1.38;
    }
    .slat:hover .slat__img,
    .slat:focus-visible .slat__img {
      transform: scale(1.06);
    }
    .slat:hover .slat__label,
    .slat:focus-visible .slat__label {
      opacity: 0;
      visibility: hidden;
      transform: skewX(calc(var(--slant) * -1)) translateY(-8px);
    }
    .slat:hover .slat__hover-title,
    .slat:focus-visible .slat__hover-title {
      opacity: 1;
      transform: rotate(-90deg) translateY(0);
    }
    .slat:hover .slat__panel,
    .slat:focus-visible .slat__panel {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------------- Versión Móvil y Táctil ---------------- */
  @media (max-width: 860px), (hover: none) {
    .slat__label {
      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
      top: 1rem;
      left: 50% !important;
      translate: -50% 0;
      transform: none !important;
      font-size: clamp(0.95rem, 4vw, 1.2rem);
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #ffffff;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.95), 0 0 16px rgba(0, 0, 0, 0.85);
      background: rgba(8, 9, 10, 0.55);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      padding: 0.35rem 1.15rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
      z-index: 5;
    }

    .slat__hover-title {
      display: none !important;
    }

    .slat__panel {
      opacity: 1 !important;
      transform: translateY(0) !important;
      padding-bottom: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slat,
    .slat__img,
    .slat__panel,
    .slat__hover-title,
    .slat__label {
      transition: none;
    }
  }
</style>
